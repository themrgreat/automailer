# Server
PORT=4000

# --- Database ---
# MongoDB connection string (e.g. from MongoDB Atlas: https://www.mongodb.com/cloud/atlas)
# Include the database name in the URI path (mongodb+srv://.../automailer) or set MONGODB_DB_NAME below.
MONGODB_URI=
MONGODB_DB_NAME=

# --- Settings encryption ---
# Required only if you configure AI provider or mail provider credentials from the
# AI Providers / Mail Providers UI pages instead of (or in addition to) the .env vars
# below. 32-byte hex string — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=

# --- AI Provider ---
# Which provider to use for email generation: "grok", "gemini", "openai", or "claude".
# Can also be set/overridden from the AI Providers page in the app (stored in MongoDB).
AI_PROVIDER=gemini

# xAI Grok (https://console.x.ai) - OpenAI-compatible Chat Completions API
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# Google Gemini (https://aistudio.google.com/apikey)
# Use a "-latest" alias (gemini-flash-latest / gemini-pro-latest) instead of a pinned
# version like gemini-2.5-pro — Google sunsets old pinned model IDs for new API keys.
# Note: on the free tier, gemini-pro-latest currently has a 0 request quota; use
# gemini-flash-latest unless you've enabled billing in Google Cloud Console.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI / ChatGPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (https://console.anthropic.com/settings/keys)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Mail Provider ---
# Which provider to use for sending: "zoho" or "gmail"
# Can also be set/overridden from the Mail Providers page in the app (stored in MongoDB).
MAIL_PROVIDER=zoho

# Zoho Mail (SMTP) - generate an app-specific password at
# https://accounts.zoho.com/home#security/app-passwords
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_USER=
ZOHO_APP_PASSWORD=
ZOHO_FROM_NAME=

# Gmail API via Google Cloud Console OAuth2
# Create an OAuth 2.0 Client ID (Desktop/Web) in Google Cloud Console,
# enable the Gmail API, and generate a refresh token for the sending mailbox
# (e.g. via https://developers.google.com/oauthplayground).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
GMAIL_FROM_NAME=